{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "e101f150-4719-4d57-b34e-9103e7f5b240",
        "UseHttps": true,
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "w8D/oGlOucBFNCI/So5rbuHm/6rBKmhBzj3tJCrpMxYePN0gTksCY/6CvneSZkJJ0hAnqVbhpCuE7bHgZQm/eQ=="
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "EasyEntityFlags": {
    "EntityFlags": [
      {
        "Label": "No Index",
        "PropertyAlias": "isIndexable",
        "Icon": "icon-block",
        "IconColorAlias": "red"
      }
    ]
  }
}